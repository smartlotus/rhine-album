{
  "name": "rhine-album",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "predev": "node scripts/patch-rolling-number.mjs && node scripts/check-album.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/patch-rolling-number.mjs && node scripts/check-album.mjs && node scripts/prepare-webfonts.mjs",
    "check:content": "node scripts/check-album.mjs && node --test scripts/check-album-test.mjs",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "review:mobile": "node scripts/serve-mobile-review.mjs",
    "export:archives": "node scripts/export-records.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "build:cloudflare": "npm run build && node scripts/package-cloudflare.mjs",
    "build:wallpaper": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && tsc && vite build --mode wallpaper --outDir release/wallpaper && node scripts/build-wallpaper.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "photos": "node scripts/build-photos.mjs",
    "add-photos": "node scripts/add-photos.mjs",
    "build:pages": "BASE_PATH=/rhine-album/ npm run build",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "check:ratio": "node --experimental-strip-types --test scripts/check-ratio-test.mjs",
    "check:landscape": "node scripts/check-landscape.mjs"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "exifr": "^7.1.3",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
